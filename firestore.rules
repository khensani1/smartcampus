rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    
    function isValidStudent(data) {
      return data.keys().hasAll(['studentNumber', 'idNumber', 'fullName', 'surname', 'email'])
          && data.keys().size() == 5
          && data.studentNumber is string && data.studentNumber.matches('^\\d{9}$')
          && data.idNumber is string && data.idNumber.size() >= 8 && data.idNumber.size() <= 13
          && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
          && data.surname is string && data.surname.size() >= 2 && data.surname.size() <= 100
          && data.email is string && data.email.size() <= 50; 
    }

    function isValidInsight(data) {
      return data.keys().hasAll(['title', 'content', 'type', 'createdAt'])
          && data.keys().size() == 4
          && data.title is string && data.title.size() <= 100
          && data.content is string && data.content.size() <= 1000
          && data.type in ['News', 'Tip', 'Deadline']
          && (data.createdAt == request.time || data.createdAt is timestamp); // Support serverTimestamp()
    }

    // --- Collection Routes ---

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidStudent(incoming());
      allow update: if isOwner(userId) && isValidId(userId)
                    && isValidStudent(incoming())
                    && incoming().studentNumber == existing().studentNumber // Immutable
                    && incoming().idNumber == existing().idNumber // Immutable
                    && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'surname', 'email']);
    }

    match /insights/{insightId} {
      allow list: if isSignedIn(); // Restricted by resource.data filter normally, but here insights are global
      allow get: if isSignedIn() && isValidId(insightId);
      allow create: if isSignedIn() && isValidId(insightId) && isValidInsight(incoming());
    }
  }
}
